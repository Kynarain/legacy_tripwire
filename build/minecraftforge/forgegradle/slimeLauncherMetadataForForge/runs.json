{
  "client": {
    "name": "client",
    "main": "net.minecraftforge.bootstrap.ForgeBootstrap",
    "parents": [],
    "args": [
      "--gameDir",
      ".",
      "--launchTarget",
      "forge_userdev_client",
      "--version",
      "MOD_DEV",
      "--assetIndex",
      "{asset_index}",
      "--assetsDir",
      "{assets_root}"
    ],
    "jvmArgs": [
      "-Djava.net.preferIPv6Addresses\u003dsystem"
    ],
    "client": true,
    "buildAllProjects": false,
    "env": {
      "MCP_MAPPINGS": "{mcp_mappings}"
    },
    "props": {
      "forge.enableGameTest": "true"
    }
  },
